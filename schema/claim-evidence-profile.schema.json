  "$id": "https://raw.githubusercontent.com/srimontidutta/solias/main/schema/claim-evidence-profile.schema.json",
  "title": "SOLIAS Claim-Evidence Profile",
  "description": "Machine-readable representation of the SOLIAS (E, C, G) profile. The permitted combinations enforce G = max(0, C - E).",
  "type": "object",
  "required": [
    "E",
    "C",
    "G"
  ],
  "properties": {
    "E": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Highest outcome level directly evaluated."
    },
    "C": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Highest outcome level presented as a result."
    },
    "G": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Claim-evidence gap, equal to max(0, C - E)."
    }
  },
