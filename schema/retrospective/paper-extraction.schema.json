        },
        "evaluation_validity": {
          "$ref": "#/$defs/observation"
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "status",
        "description",
        "supporting_reference"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "present",
            "absent",
            "unclear",
            "not_applicable"
          ]
        },
        "description": {
          "type": "string"
        },
        "supporting_reference": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
