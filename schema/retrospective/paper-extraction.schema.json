      ],
      "additionalProperties": false
    },
    "demonstrated_evidence": {
      "type": "object",
      "required": [
        "description",
        "supporting_reference"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Highest outcome directly evaluated, described in relation to the population, context, and measures reported in the paper."
        },
        "supporting_reference": {
          "type": "string",
          "minLength": 1,
          "description": "Page, section, table, figure, or other source location supporting E."
        }
      }
    },
    "claimed_outcome": {
      "type": "object",
      "required": [
        "description",
        "supporting_reference"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Highest outcome presented as a result, with motivation and intended use distinguished where possible."
        },
        "supporting_reference": {
          "type": "string",
          "minLength": 1,
          "description": "Page, section, or other source location supporting C."
        }
      }
    },
    "prospective_components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "social_problem_target_population_stakeholders": {
          "$ref": "#/$defs/observation"
        },
        "nlp_function_and_use_context": {
          "$ref": "#/$defs/observation"
        },
        "theory_of_change": {
          "$ref": "#/$defs/observation"
        },
        "outcome_evaluation": {
