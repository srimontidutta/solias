{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/srimontidutta/solias/main/schema/retrospective/paper-extraction.schema.json",
  "title": "SOLIAS Structured Paper Extraction",
  "description": "Structured representation for retrospective application of SOLIAS in evidence synthesis, following the retrospective indicators described in the paper.",
  "type": "object",
  "required": [
    "paper",
    "claim_evidence_profile",
    "demonstrated_evidence",
    "claimed_outcome",
    "prospective_components"
  ],
  "properties": {
    "paper": {
      "type": "object",
      "required": [
        "identifier",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "claim_evidence_profile": {
      "type": "object",
      "required": [
        "E",
        "C",
        "G"
      ],
      "properties": {
        "E": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Highest outcome level directly evaluated."
        },
        "C": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Highest outcome level presented as a result."
        },
        "G": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Claim-evidence gap, equal to max(0, C - E)."
        }
      },
      "oneOf": [
        {
          "properties": {
            "E": {
              "const": 0
            },
            "C": {
              "const": 0
            },
            "G": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "E": {
              "const": 0
            },
            "C": {
              "const": 1
            },
            "G": {
              "const": 1
            }
          }
        },
        {
          "properties": {
